{
  "name": "uk-english-pass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content:generate": "node scripts/generate-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "audio:generate": ".audio-env/Scripts/python.exe scripts/generate_audio.py",
    "audio:validate": "node scripts/validate-audio.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "pnpm content:validate && pnpm audio:validate && pnpm test && pnpm build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest"
  }
}
